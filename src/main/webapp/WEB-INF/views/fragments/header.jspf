<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> · SmartCity360</title>
    <link rel="icon" type="image/png" sizes="1254x1254" href="${pageContext.request.contextPath}/assets/images/smartcity360-icon.png">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/dashboard.css">
</head>
<body>
<div class="app-shell">
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="${pageContext.request.contextPath}/dashboard">
            <img class="brand-mark" src="${pageContext.request.contextPath}/assets/images/smartcity360-icon.png" alt="SmartCity360 icon">
            <span><strong>SmartCity360</strong><small>360 MANAGEMENT</small></span>
        </a>
        <div class="nav-caption">PLATFORM</div>
        <nav class="nav-list" aria-label="Main navigation">
            <a class="nav-item ${activeNav == 'dashboard' ? 'active' : ''}" href="${pageContext.request.contextPath}/dashboard"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/></svg>Overview</a>
            <a class="nav-item ${activeNav == 'complaints' ? 'active' : ''}" href="${pageContext.request.contextPath}/complaints"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H6l-3 2v-6.5a7.5 7.5 0 1 1 17-3z"/><path d="M8 11h8M8 14h5"/></svg>Complaints</a>
            <c:if test="${sessionScope.authenticatedUser.roleName == 'CITY_MANAGER'}">
                <a class="nav-item ${activeNav == 'security' ? 'active' : ''}" href="${pageContext.request.contextPath}/security-streams"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 18V6m0 12h16M7 14l4-4 3 2 5-6"/><circle cx="7" cy="14" r="1"/><circle cx="11" cy="10" r="1"/><circle cx="14" cy="12" r="1"/><circle cx="19" cy="6" r="1"/></svg>Meters</a>
                <a class="nav-item ${activeNav == 'zones' ? 'active' : ''}" href="${pageContext.request.contextPath}/smart-zones"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6.5 8.5 4l7 2.5L21 4v13.5L15.5 20l-7-2.5L3 20z"/><path d="M8.5 4v13.5m7-11V20"/></svg>Smart Zones</a>
                <a class="nav-item ${activeNav == 'streetlights' ? 'active' : ''}" href="${pageContext.request.contextPath}/streetlights"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v2m0 14v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M3 12h2m14 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/><circle cx="12" cy="12" r="5"/></svg>Streetlights</a>
                <a class="nav-item ${activeNav == 'policies' ? 'active' : ''}" href="${pageContext.request.contextPath}/policies"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 12h6m-6 4h6"/></svg>City policies</a>
                <a class="nav-item ${activeNav == 'users' ? 'active' : ''}" href="${pageContext.request.contextPath}/user-management"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3"/><path d="M3.5 20v-1.5a5.5 5.5 0 0 1 11 0V20zM16 5.5a3 3 0 0 1 0 5.8m2 3a5 5 0 0 1 2.5 4.2V20h-3"/></svg>User management</a>
            </c:if>
        </nav>
        <div class="sidebar-bottom">
            <span class="status-dot"></span>
            <span>Operations console</span>
        </div>
    </aside>
    <div class="main-shell">
        <header class="topbar">
            <button type="button" class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">☰</button>
            <div class="breadcrumb">Smart City <span>/</span> <strong><c:out value="${pageTitle}"/></strong></div>
            <div class="topbar-right">
                <span class="avatar"><c:out value="${sessionScope.authenticatedUser.initials}"/></span>
                <span><c:out value="${sessionScope.authenticatedUser.fullName}"/> &middot; <c:out value="${sessionScope.authenticatedUser.roleName}"/></span>
                <form method="post" action="${pageContext.request.contextPath}/logout" class="logout-form">
                    <input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}'/>">
                    <button class="button button-small button-quiet" type="submit">Sign out</button>
                </form>
            </div>
        </header>
        <main class="content">
            <c:if test="${not empty error}">
                <div class="alert alert-error" role="alert" aria-live="assertive"><span>!</span><c:out value="${error}"/><button type="button" class="alert-dismiss" data-alert-dismiss aria-label="Dismiss error">×</button></div>
            </c:if>
            <c:if test="${not empty success}">
                <div class="alert alert-success" role="status" aria-live="polite"><span>✓</span><c:out value="${success}"/><button type="button" class="alert-dismiss" data-alert-dismiss aria-label="Dismiss notification">×</button></div>
            </c:if>
